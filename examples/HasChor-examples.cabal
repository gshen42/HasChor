cabal-version:      3.0
name:               HasChor-examples
version:            0.1.0.1
synopsis:           Examples for HasChor

tested-with:
    GHC == 9.6.7

executable concur-server
    hs-source-dirs:   explicit-parallel/concur-server
    main-is:          Main.hs
    default-language: GHC2021
    build-depends:
        base                 ^>= 4.18.3,
        HasChor

executable microservices
    hs-source-dirs:   explicit-parallel/microservices
    main-is:          Main.hs
    default-language: GHC2021
    build-depends:
        base                 ^>= 4.18.3,
        HasChor

executable quorum-voting
    hs-source-dirs:   explicit-parallel/quorum-voting
    main-is:          Main.hs
    default-language: GHC2021
    build-depends:
        base                 ^>= 4.18.3,
        stm                  ^>= 2.5.1,
        HasChor

executable nshaped
    hs-source-dirs:   explicit-parallel/nshaped
    main-is:          Main.hs
    default-language: GHC2021
    build-depends:
        base                 ^>= 4.18.3,
        stm                  ^>= 2.5.1,
        HasChor

executable too-much-ooo
    hs-source-dirs:   explicit-parallel/too-much-ooo
    main-is:          Main.hs
    default-language: GHC2021
    build-depends:
        base                 ^>= 4.18.3,
        HasChor
